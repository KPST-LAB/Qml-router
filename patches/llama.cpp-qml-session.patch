+//===========================================================================//
+// [FTS-RECALL] BEGIN — shared injection helper for both auto-continue
+// branches (resident and stored). Additive-only; removal instructions in
+// storage/sqlite/qml_sqlite_store.h. Placement contract: call AFTER the
+// history tokens are inserted and BEFORE the new turn is inserted, so the
+// history prefix (and any blob restore of it) stays byte-identical.
+//===========================================================================//
+static void qml_fts_recall_inject(server_slot & slot, server_task & task,
+                                  llama_tokens & new_part, size_t n_hist) {
+    if (!qml_llama_recall_on()) {
+        return;
+    }
+    const llama_vocab * rec_vocab =
+        llama_model_get_vocab(llama_get_model(slot.ctx_tgt));
+    const std::string rec_query =
+        common_detokenize(slot.ctx_tgt, new_part, false);
+    auto rec_detok = +[](void * ud, const int32_t * toks, size_t n) -> char * {
+        const std::string s2 = common_detokenize(
+            (llama_context *) ud, std::vector<llama_token>(toks, toks + n), false);
