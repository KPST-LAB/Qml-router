+    // reserve; the hook derives its dynamic budget and per-turn size cap
+    // from this instead of a fixed constant.
+    const size_t rec_reserve = 512;
+    const size_t rec_used    = n_hist + new_part.size() + rec_reserve;
+    const size_t ren_ctx_avail   = ((size_t) slot.n_ctx > rec_used)
+                                 ? (size_t) slot.n_ctx - rec_used : 0;
+    const size_t rec_n = qml_llama_recall(
+        task.params.session_id.c_str(), rec_query.c_str(),
+        (int32_t) llama_vocab_eot(rec_vocab), ren_ctx_avail,
+        rec_detok, (void *) slot.ctx_tgt, &rec_toks);
+    if (rec_n > 0 && n_hist + rec_n + new_part.size() < (size_t) slot.n_ctx) {
+        // [RECALL-EOT] The stored history can end inside an open assistant turn
+        // (generation stopped at n_predict, no end-of-turn token); the client then
+        // starts the new turn with the end-of-turn token that closes it. Records
+        // inserted before that token would leave the assistant turn open and put
+        // a second end-of-turn token after them, so the token moves in front of
+        // the records.
+        const llama_token eot = llama_vocab_eot(rec_vocab);
+        if (task.tokens.size() > 0 && task.tokens[task.tokens.size() - 1] != eot &&
+            !new_part.empty() && new_part.front() == eot) {
+            task.tokens.insert(llama_tokens(1, eot));
+            new_part.erase(new_part.begin());
+        }
+        task.tokens.insert(llama_tokens(rec_toks, rec_toks + rec_n));
+        SLT_INF(slot, "qml-router: [fts-recall] re-injected %zu archived token(s) between history and the new turn\n",
+                rec_n);
+    }
+    free(rec_toks);
+}
